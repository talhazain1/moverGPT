<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Chatbot - Admin Panel</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="style.css" rel="stylesheet">
  <style>
    #chat-container {
      height: 400px;
      overflow-y: auto;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: 15px;
      background-color: var(--light-bg);
      margin-bottom: 15px;
    }
    .user-message {
      background-color: #4361ee;
      color: white;
      padding: 12px;
      border-radius: var(--border-radius);
      margin-bottom: 10px;
      max-width: 80%;
      margin-left: auto;
      margin-right: 10px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      word-break: break-word;
      position: relative;
    }
    .bot-message {
      background-color: #f5f5f5;
      color: #333;
      padding: 12px;
      border-radius: var(--border-radius);
      margin-bottom: 10px;
      max-width: 80%;
      margin-right: auto;
      margin-left: 10px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      border: 1px solid var(--border-color);
      word-break: break-word;
      position: relative;
    }
    .message-timestamp {
      font-size: 0.7rem;
      color: rgba(0,0,0,0.5);
      position: absolute;
      bottom: 3px;
      right: 8px;
    }
    .user-message .message-timestamp {
      color: rgba(255,255,255,0.7);
    }
    .message-content {
      margin-bottom: 15px;
    }
    .message-rating {
      display: flex;
      justify-content: flex-end;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid rgba(0,0,0,0.1);
    }
    .rating-button {
      background: none;
      border: none;
      font-size: 14px;
      margin-left: 8px;
      cursor: pointer;
      padding: 2px 5px;
      border-radius: 50%;
      transition: all 0.2s;
      color: #999;
    }
    .rating-button:hover {
      transform: scale(1.2);
    }
    .rating-button.selected {
      color: gold;
      text-shadow: 0 0 2px rgba(0,0,0,0.3);
    }
    .rating-button.thumbs-up.selected {
      color: #28a745;
    }
    .rating-button.thumbs-down.selected {
      color: #dc3545;
    }
    .response-id {
      display: none;
    }
    .rating-feedback {
      font-size: 10px;
      color: #28a745;
      margin-left: 5px;
      font-style: italic;
    }
    #loading-indicator {
      display: none;
      margin-top: 15px;
    }
    .input-group {
      display: flex;
      margin-top: 15px;
    }
    .input-group input {
      flex: 1;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius) 0 0 var(--border-radius);
      padding: 10px 15px;
      outline: none;
    }
    .input-group button {
      border-radius: 0 var(--border-radius) var(--border-radius) 0;
      border: none;
      background-color: var(--primary-color);
      color: white;
      padding: 10px 20px;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    .input-group button:hover {
      background-color: var(--primary-color-dark);
    }
    .alert-container {
      position: fixed;
      top: 20px;
      right: 20px;
      max-width: 350px;
      z-index: 1050;
    }
    .alert {
      padding: 15px;
      margin-bottom: 10px;
      border-radius: var(--border-radius);
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .alert-success {
      background-color: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }
    .alert-danger {
      background-color: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
    .alert-warning {
      background-color: #fff3cd;
      color: #856404;
      border: 1px solid #ffeeba;
    }
    .alert-info {
      background-color: #d1ecf1;
      color: #0c5460;
      border: 1px solid #bee5eb;
    }
    .close {
      background: none;
      border: none;
      font-size: 1.25rem;
      cursor: pointer;
      padding: 0 5px;
    }
    .spinner {
      border: 3px solid rgba(0, 0, 0, 0.1);
      border-radius: 50%;
      border-top: 3px solid var(--primary-color);
      width: 20px;
      height: 20px;
      animation: spin 1s linear infinite;
      margin: 0 auto;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="alert-container"></div>

  <div class="admin-layout">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-brand">
          <img id="sidebarLogo" src="https://ui-avatars.com/api/?name=Company&background=random" alt="Logo" class="sidebar-logo" style="width: 32px; height: 32px; border-radius: 50%; margin-right: 10px;">
          <span id="sidebarCompanyName">Company Admin</span>
        </div>
        <button class="sidebar-toggle">
          <i class="fas fa-bars"></i>
        </button>
      </div>
      
      <ul class="sidebar-menu">
        <li class="sidebar-item">
          <a href="/static/dashboard.html" class="sidebar-link">
            <i class="fas fa-tachometer-alt"></i>
            <span>Dashboard</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/static/profile.html" class="sidebar-link">
            <i class="fas fa-user-circle"></i>
            <span>Profile</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/static/chatbot_builder.html" class="sidebar-link">
            <i class="fas fa-robot"></i>
            <span>Chatbot Builder</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/static/test.html" class="sidebar-link active">
            <i class="fas fa-vial"></i>
            <span>Test Chatbot</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/static/admin.html" class="sidebar-link">
            <i class="fas fa-cog"></i>
            <span>Admin Settings</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/static/pricing.html" class="sidebar-link">
            <i class="fas fa-tag"></i>
            <span>Pricing Plans</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/static/index.html" class="sidebar-link">
            <i class="fas fa-home"></i>
            <span>Landing Page</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="#" id="logoutBtn" class="sidebar-link">
            <i class="fas fa-sign-out-alt"></i>
            <span>Logout</span>
          </a>
        </li>
      </ul>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
      <!-- Header -->
      <div class="main-header">
        <div class="header-left">
          <button class="header-toggle d-lg-none">
            <i class="fas fa-bars"></i>
          </button>
          <h4>Test Chatbot</h4>
        </div>
        
        <div class="header-right">
          <div class="user-dropdown">
            <div class="user-info">
              <div>
                <div class="user-name">User</div>
                <div class="user-role" style="font-size: 0.7rem; color: var(--gray-600);">Member</div>
              </div>
              <img src="https://ui-avatars.com/api/?name=User&background=random" alt="User" class="user-avatar">
            </div>
            
            <div class="user-dropdown-menu" style="display: none; position: absolute; top: 100%; right: 0; background: white; box-shadow: var(--box-shadow); border-radius: var(--border-radius); padding: 0.5rem 0; min-width: 200px; margin-top: 0.5rem; z-index: 1000;">
              <a href="/static/profile.html" style="display: block; padding: 0.5rem 1rem; color: var(--gray-700);">
                <i class="fas fa-user-circle"></i> Manage Profile
              </a>
              <a href="/static/admin.html" style="display: block; padding: 0.5rem 1rem; color: var(--gray-700);">
                <i class="fas fa-cog"></i> Settings
              </a>
              <div style="height: 1px; background-color: var(--gray-200); margin: 0.5rem 0;"></div>
              <a href="#" id="dropdownLogoutBtn" style="display: block; padding: 0.5rem 1rem; color: var(--danger-color);">
                <i class="fas fa-sign-out-alt"></i> Logout
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Page Container -->
      <div class="page-container">
        <div class="card">
          <div class="card-header">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h5 class="card-title mb-0">Chat with your Chatbot</h5>
              <button type="button" id="clearChatBtn" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-trash-alt"></i> Clear Chat
              </button>
            </div>
            <p class="mt-2 text-muted">This is where you can test your chatbot's responses in real-time.</p>
          </div>
          <div class="card-body">
            <div id="chat-container"></div>
            <div class="input-group">
              <input type="text" id="user-input" class="form-control" placeholder="Type your message...">
              <button id="send-button" class="btn btn-primary">
                <i class="fas fa-paper-plane"></i> Send
              </button>
            </div>
            <div id="loading-indicator" class="text-center mt-3">
              <div class="spinner"></div>
              <p class="mt-2">Thinking...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/static/assets/auth.js"></script>
  <script>
    // Function to update sidebar company info
    function updateSidebarCompanyInfo(user) {
      // Update company name in sidebar
      const companyNameElement = document.getElementById('sidebarCompanyName');
      if (companyNameElement) {
        companyNameElement.textContent = user.company_name || 'Company Admin';
      }
      
      // Update logo in sidebar
      const sidebarLogoElement = document.getElementById('sidebarLogo');
      if (sidebarLogoElement) {
        if (user.company_logo) {
          sidebarLogoElement.src = user.company_logo;
        } else {
          // Generate avatar based on company name
          const companyName = user.company_name || 'Company';
          sidebarLogoElement.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(companyName)}&background=random`;
        }
      }
      
      // Update header user info
      const userNameElement = document.querySelector('.user-name');
      if (userNameElement) {
        userNameElement.textContent = user.user_name || 'User';
      }
      
      const userRoleElement = document.querySelector('.user-role');
      if (userRoleElement) {
        userRoleElement.textContent = user.role || 'Member';
      }
      
      const userAvatarElement = document.querySelector('.user-avatar');
      if (userAvatarElement) {
        if (user.company_logo) {
          userAvatarElement.src = user.company_logo;
        } else {
          userAvatarElement.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(user.user_name || 'User')}&background=random`;
        }
      }
    }
    
    // Store the conversation history
    let conversationHistory = [];
    let companyId = null;
    let userId = null;
    let chatSessionId = localStorage.getItem('chat_session_id');
    let botName = 'Chatbot';
    let isChatbotTrained = false; // Flag to track if the chatbot is trained

    // Function to train the chatbot
    async function trainChatbot() {
      const chatContainer = document.getElementById('chat-container');
      
      // Show training message
      addMessage("Starting training process... This might take a moment.", 'bot');
      
      try {
        // First get the chatbot info to see if we already have data
        const infoResponse = await fetch('/api/chatbot/info', {
          method: 'GET',
          credentials: 'include'
        });
        
        const chatbotData = await infoResponse.json();
        
        if (chatbotData.status !== 'success' || !chatbotData.data) {
          addMessage("Error: No chatbot found. Please go to the Chatbot Builder to create one first.", 'bot');
          return;
        }
        
        const chatbotId = chatbotData.data.id;
        
        // Attempt to train the chatbot
        const trainResponse = await fetch(`/api/chatbot/${chatbotId}/train`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const trainResult = await trainResponse.json();
        
        if (trainResult.success || trainResult.status === 'success') {
          // Training succeeded
          isChatbotTrained = true;
          addMessage("🎉 Training completed successfully! You can now ask me specific questions about your business.", 'bot');
          showAlert('Chatbot training completed successfully!', 'success');
        } else {
          // Training failed
          addMessage("Training failed. Error: " + (trainResult.message || 'Unknown error'), 'bot');
          addMessage("Please go to the Chatbot Builder and ensure you have added FAQs or knowledge base content.", 'bot');
          showAlert('Training failed. Please check your knowledge base content.', 'danger');
        }
      } catch (error) {
        console.error('Error during training:', error);
        addMessage("An error occurred during training: " + error.message, 'bot');
        showAlert('Error during training: ' + error.message, 'danger');
      }
    }

    // Function to show knowledge base content for diagnostic purposes
    async function showKnowledgeBase() {
      try {
        // Get chatbot info
        const infoResponse = await fetch('/api/chatbot/info', {
          method: 'GET',
          credentials: 'include'
        });
        
        const chatbotData = await infoResponse.json();
        
        if (chatbotData.status !== 'success' || !chatbotData.data) {
          addMessage("Error: No chatbot found. Please go to the Chatbot Builder to create one first.", 'bot');
          return;
        }
        
        // Get the knowledge base content
        const knowledgeBase = chatbotData.data.knowledge_base;
        
        if (!knowledgeBase || Object.keys(knowledgeBase).length === 0) {
          addMessage("Your chatbot doesn't have any knowledge base content. Please add FAQs or upload a knowledge base in the Chatbot Builder.", 'bot');
          return;
        }
        
        // Process FAQs if available
        const faqs = knowledgeBase.faqs || [];
        
        if (faqs.length === 0) {
          addMessage("Your knowledge base doesn't contain any FAQs. Please add some in the Chatbot Builder.", 'bot');
        } else {
          // Show the first few FAQs
          addMessage(`Here's what I know (${faqs.length} FAQs total):`, 'bot');
          
          // Show at most 3 FAQs to avoid cluttering the chat
          const displayCount = Math.min(3, faqs.length);
          for (let i = 0; i < displayCount; i++) {
            const faq = faqs[i];
            if (faq.question && faq.answer) {
              setTimeout(() => {
                addMessage(`Q: ${faq.question}\nA: ${faq.answer}`, 'bot');
              }, 500 * (i + 1));
            }
          }
          
          if (faqs.length > 3) {
            setTimeout(() => {
              addMessage(`... and ${faqs.length - 3} more FAQs. Check the Chatbot Builder for the complete list.`, 'bot');
            }, 500 * (displayCount + 1));
          }
        }
        
        // Check for other knowledge base content
        const otherKeys = Object.keys(knowledgeBase).filter(key => key !== 'faqs');
        if (otherKeys.length > 0) {
          setTimeout(() => {
            addMessage(`Your knowledge base also contains: ${otherKeys.join(', ')}`, 'bot');
          }, 500 * (faqs.length > 3 ? 5 : faqs.length + 2));
        }
      } catch (error) {
        console.error('Error fetching knowledge base:', error);
        addMessage("An error occurred while retrieving the knowledge base: " + error.message, 'bot');
      }
    }

    // Fetch and display chatbot rating statistics
    async function showRatingStatistics() {
      try {
        // First check if we have a chatbot
        const infoResponse = await fetch('/api/chatbot/info', {
          method: 'GET',
          credentials: 'include'
        });
        
        const chatbotData = await infoResponse.json();
        
        if (chatbotData.status !== 'success' || !chatbotData.data) {
          addMessage("Error: No chatbot found. Please create one first.", 'bot');
          return;
        }
        
        const chatbotId = chatbotData.data.id;
        
        // Fetch statistics for this chatbot
        const statsResponse = await fetch(`/api/chatbot/${chatbotId}/analytics`, {
          method: 'GET',
          credentials: 'include'
        });
        
        if (!statsResponse.ok) {
          throw new Error(`Failed to fetch statistics: ${statsResponse.status} ${statsResponse.statusText}`);
        }
        
        const statsData = await statsResponse.json();
        
        if (!statsData.success && !statsData.data) {
          addMessage("Statistics are not available for this chatbot yet.", 'bot');
          return;
        }
        
        // Extract rating statistics
        const stats = statsData.data || statsData;
        const totalMessages = stats.total_messages || 0;
        const positiveFeedback = stats.positive_feedback_count || 0;
        const totalFeedback = stats.total_feedback_count || 0;
        const satisfactionRate = stats.satisfaction_rate || 0;
        
        // Create a feedback summary message
        let statsMessage = `📊 **Chatbot Satisfaction Statistics**\n\n`;
        statsMessage += `Total messages: ${totalMessages}\n`;
        statsMessage += `Feedback received: ${totalFeedback}\n`;
        statsMessage += `Positive feedback: ${positiveFeedback}\n`;
        
        if (totalFeedback > 0) {
          const satisfactionPercent = Math.round(satisfactionRate * 100) / 100;
          statsMessage += `Satisfaction rate: ${satisfactionPercent}%\n`;
          
          // Add visual representation
          if (satisfactionRate >= 90) {
            statsMessage += `\nStatus: 🟢 Excellent`;
          } else if (satisfactionRate >= 75) {
            statsMessage += `\nStatus: 🟡 Good`;
          } else if (satisfactionRate >= 50) {
            statsMessage += `\nStatus: 🟠 Average`;
          } else {
            statsMessage += `\nStatus: 🔴 Needs improvement`;
          }
        } else {
          statsMessage += `\nNot enough ratings to calculate a satisfaction rate yet. Please rate some responses!`;
        }
        
        // Display the statistics in the chat
        addMessage(statsMessage, 'bot');
        
      } catch (error) {
        console.error('Error fetching rating statistics:', error);
        addMessage(`Error fetching statistics: ${error.message}`, 'bot');
      }
    }

    // Add a "View Knowledge Base" menu option
    function addViewKnowledgeBaseOption() {
      // Add a button to the card header
      const cardHeader = document.querySelector('.card-header > div');
      const diagnoseButton = document.createElement('button');
      diagnoseButton.className = 'btn btn-sm btn-outline-info ml-2';
      diagnoseButton.innerHTML = '<i class="fas fa-database"></i> View Knowledge Base';
      diagnoseButton.addEventListener('click', showKnowledgeBase);
      cardHeader.appendChild(diagnoseButton);
    }

    // Add a "View Statistics" menu option
    function addViewStatisticsOption() {
      // Add a button to the card header
      const cardHeader = document.querySelector('.card-header > div');
      const statsButton = document.createElement('button');
      statsButton.className = 'btn btn-sm btn-outline-success ml-2';
      statsButton.innerHTML = '<i class="fas fa-chart-bar"></i> View Ratings';
      statsButton.addEventListener('click', showRatingStatistics);
      cardHeader.appendChild(statsButton);
    }

    // Initialize test interface
    async function initTestInterface() {
      try {
        // Initialize authentication
        const user = await Auth.init();
        if (!user) return;
        
        // Update sidebar company info
        updateSidebarCompanyInfo(user);
        
        // Set company and user ID
        companyId = user.company_id || user.id;
        userId = user.id;
        
        // Get chatbot info and check if it's trained
        try {
          const botResponse = await fetch('/api/chatbot/info', {
            method: 'GET',
            credentials: 'include'
          });
          
          const botData = await botResponse.json();
          
          if (botData.status === 'success' && botData.data) {
            botName = botData.data.bot_name || 'Chatbot';
            
            // Check if chatbot is trained by making a test request
            const testResponse = await fetch('/api/chatbot/inference', {
              method: 'POST',
              credentials: 'include',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                company_id: companyId,
                query: "test query for training check"
              })
            });
            
            const testData = await testResponse.json();
            
            // Check if the response indicates the chatbot is not trained
            if (testData.status === 'error' || 
                (testData.response && testData.response.includes("I'm not trained yet"))) {
              isChatbotTrained = false;
              
              // Display a message about the chatbot not being trained
              addMessage(`👋 Welcome to ${botName}! I see that I haven't been fully trained yet. Please go to the Chatbot Builder page to add FAQs or upload knowledge base content first. In the meantime, I can answer some basic questions.`, 'bot');
              
              // Show a warning alert
              showAlert("Your chatbot needs training. Please go to the Chatbot Builder, add content, and save changes to train your chatbot.", "warning");
              
              // Add a direct link to make it easier
              setTimeout(() => {
                showAlert('Click <a href="/static/chatbot_builder.html" style="color: #856404; text-decoration: underline; font-weight: bold;">here</a> to go to the Chatbot Builder', 'warning');
              }, 2000);
            } else {
              isChatbotTrained = true;
              // Add welcome message using the welcome_message from chatbot config if available
              const welcomeMessage = botData.data.welcome_message || 
                `👋 Welcome to ${botName}! I'm here to assist you with any questions you might have. Type a message to start chatting.`;
              addMessage(welcomeMessage, 'bot');
              
              // Add a message about rating
              setTimeout(() => {
                addMessage("Don't forget to rate my responses using the thumbs up/down buttons! Your feedback helps me improve.", 'bot');
              }, 1000);
            }
          } else {
            // Default welcome message with more personality
            addMessage(`👋 Hello! I'm your test chatbot assistant. It appears you haven't created a chatbot yet. Please go to the Chatbot Builder page to create one first.`, 'bot');
            showAlert("No chatbot found. Please create one in the Chatbot Builder.", "warning");
          }
        } catch (error) {
          console.error('Error fetching chatbot info:', error);
          // Default welcome message on error with more personality
          addMessage(`👋 Hello there! I'm your test chatbot. I'm ready to chat - what would you like to know?`, 'bot');
        }
        
        // Add event listeners
        document.getElementById('send-button').addEventListener('click', sendMessage);
        
        document.getElementById('user-input').addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            sendMessage();
          }
        });
        
        document.getElementById('clearChatBtn').addEventListener('click', clearChat);
        
        // Toggle user dropdown
        document.querySelector('.user-info').addEventListener('click', function() {
          const dropdownMenu = document.querySelector('.user-dropdown-menu');
          dropdownMenu.style.display = dropdownMenu.style.display === 'none' ? 'block' : 'none';
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
          const userInfo = document.querySelector('.user-info');
          const dropdownMenu = document.querySelector('.user-dropdown-menu');
          
          if (!userInfo.contains(event.target) && !dropdownMenu.contains(event.target)) {
            dropdownMenu.style.display = 'none';
          }
        });
        
        // Setup logout handlers
        document.getElementById('logoutBtn').addEventListener('click', function(e) {
          e.preventDefault();
          Auth.logout();
        });
        
        document.getElementById('dropdownLogoutBtn').addEventListener('click', function(e) {
          e.preventDefault();
          Auth.logout();
        });

        // Add a train chatbot button if needed
        if (!isChatbotTrained) {
          const cardHeader = document.querySelector('.card-header > div');
          const trainButton = document.createElement('button');
          trainButton.className = 'btn btn-sm btn-outline-primary ml-2';
          trainButton.innerHTML = '<i class="fas fa-graduation-cap"></i> Train Chatbot';
          trainButton.addEventListener('click', trainChatbot);
          cardHeader.appendChild(trainButton);
        }
        
        // Add the View Knowledge Base button
        addViewKnowledgeBaseOption();
        
        // Add the View Statistics button
        addViewStatisticsOption();
      } catch (error) {
        console.error('Error initializing test interface:', error);
        showAlert('Error initializing test interface: ' + error.message, 'danger');
      }
    }

    // Add a message to the chat container
    function addMessage(message, sender, messageId = null) {
      const chatContainer = document.getElementById('chat-container');
      const messageElement = document.createElement('div');
      messageElement.className = sender + '-message';
      
      // Format the message with timestamp
      const now = new Date();
      const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      
      // Create HTML structure based on sender type
      if (sender === 'bot') {
        // For bot messages, include rating buttons
        messageElement.innerHTML = `
          <div class="message-content">${message}</div>
          <div class="message-timestamp">${timeString}</div>
          <div class="response-id">${messageId || ''}</div>
          <div class="message-rating">
            <div class="rating-feedback"></div>
            <button class="rating-button thumbs-up" title="Helpful response">
              <i class="fas fa-thumbs-up"></i>
            </button>
            <button class="rating-button thumbs-down" title="Not helpful">
              <i class="fas fa-thumbs-down"></i>
            </button>
          </div>
        `;
      } else {
        // For user messages, just show the message and timestamp
        messageElement.innerHTML = `
          <div class="message-content">${message}</div>
          <div class="message-timestamp">${timeString}</div>
        `;
      }
      
      chatContainer.appendChild(messageElement);
      chatContainer.scrollTop = chatContainer.scrollHeight;
      
      // Add to conversation history - keep only content without HTML
      const historyItem = {
        sender: sender,
        message: message,
        timestamp: now
      };
      
      // Add message ID if it exists (for rating purposes)
      if (messageId) {
        historyItem.messageId = messageId;
      }
      
      conversationHistory.push(historyItem);
      
      // Keep only the last 10 messages
      if (conversationHistory.length > 10) {
        conversationHistory = conversationHistory.slice(conversationHistory.length - 10);
      }
      
      // Add event listeners to rating buttons if this is a bot message
      if (sender === 'bot') {
        const thumbsUp = messageElement.querySelector('.thumbs-up');
        const thumbsDown = messageElement.querySelector('.thumbs-down');
        
        if (thumbsUp && thumbsDown) {
          thumbsUp.addEventListener('click', function() {
            submitRating(messageElement, 'positive');
          });
          
          thumbsDown.addEventListener('click', function() {
            submitRating(messageElement, 'negative');
          });
        }
      }
      
      return messageElement;
    }
    
    // Submit a rating for a bot message
    async function submitRating(messageElement, rating) {
      // Get the session ID and message ID
      const messageId = messageElement.querySelector('.response-id').textContent;
      
      if (!messageId && !chatSessionId) {
        showAlert('Cannot rate this message as it has no ID', 'warning');
        return;
      }
      
      // Update the UI to show the selected rating
      const thumbsUp = messageElement.querySelector('.thumbs-up');
      const thumbsDown = messageElement.querySelector('.thumbs-down');
      const feedbackElement = messageElement.querySelector('.rating-feedback');
      
      // Remove any existing selected class
      thumbsUp.classList.remove('selected');
      thumbsDown.classList.remove('selected');
      
      // Add the selected class to the clicked button
      if (rating === 'positive') {
        thumbsUp.classList.add('selected');
        feedbackElement.textContent = 'Marked as helpful!';
      } else {
        thumbsDown.classList.add('selected');
        feedbackElement.textContent = 'Marked as not helpful.';
      }
      
      try {
        // Submit the rating to the backend
        const response = await fetch('/api/chatbot/rate', {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            message_id: messageId || null,
            session_id: chatSessionId,
            rating: rating,
            feedback: rating === 'positive' ? 'positive' : 'negative'
          })
        });
        
        const data = await response.json();
        
        if (data.status === 'success') {
          // Success feedback is already shown
        } else {
          feedbackElement.textContent = 'Rating not saved.';
          console.error('Failed to save rating:', data.message);
        }
      } catch (error) {
        console.error('Error submitting rating:', error);
        feedbackElement.textContent = 'Error saving rating.';
      }
    }

    // Clear chat history
    function clearChat() {
      const chatContainer = document.getElementById('chat-container');
      chatContainer.innerHTML = '';
      conversationHistory = [];
      chatSessionId = null;
      localStorage.removeItem('chat_session_id');
      
      // Add welcome message
      addMessage(`Chat cleared. Type a message to start a new conversation with ${botName}.`, 'bot');
    }

    // Handle common questions with default responses
    function handleCommonQuestions(query) {
      // Convert query to lowercase for easier matching
      const q = query.toLowerCase().trim();
      
      // Common greetings
      if (q.includes('hello') || q.includes('hi') || q === 'hey' || q.includes('greetings')) {
        return `👋 Hello there! How can I assist you today?`;
      }
      
      // Thank you responses
      if (q.includes('thank you') || q.includes('thanks') || q === 'thx' || q === 'ty') {
        return `You're welcome! Is there anything else I can help you with?`;
      }
      
      // About queries
      if (q.includes('who are you') || q.includes('what are you') || q.includes('tell me about you')) {
        return `I'm ${botName}, a chatbot designed to answer questions and provide assistance. I'm here to make your experience better and provide helpful information!`;
      }
      
      // Business inquiries
      if (q.includes('about your business') || q.includes('about the company') || q.includes('what do you do') || q.includes('what does your company do')) {
        return `I represent a business that offers various products and services. For specific details about what we offer, you can check our main website or ask me specific questions about our offerings.`;
      }
      
      // Help queries
      if (q.includes('help') || q.includes('can you assist') || q.includes('support') || q === 'help') {
        return `I'm here to help! I can answer questions about our products, services, or provide general information. What specific assistance do you need today?`;
      }
      
      // Not trained yet
      if (q.includes('not trained') || q.includes('train me')) {
        return `I understand you're asking about training. To get the best responses, the admin can go to the Chatbot Builder page and add FAQs or upload a knowledge base to enhance my capabilities.`;
      }
      
      // Services inquiry
      if (q.includes('services') || q.includes('what services') || q.includes('offer')) {
        return `We offer a range of services designed to meet your needs. For specific information about our services, please ask about a particular area you're interested in.`;
      }
      
      // Contact information
      if (q.includes('contact') || q.includes('reach you') || q.includes('email') || q.includes('phone') || q.includes('call')) {
        return `For contact information, please visit our website's contact page or reach out through the provided channels on our site.`;
      }
      
      // Pricing inquiries
      if (q.includes('price') || q.includes('cost') || q.includes('how much') || q.includes('pricing')) {
        return `Pricing information can vary based on specific products or services. For detailed pricing, please visit our pricing page or ask about a specific product or service.`;
      }
      
      // FAQ about chatbot capabilities
      if (q.includes('what can you do') || q.includes('capabilities') || q.includes('features')) {
        return `I can answer questions, provide information about products and services, help with common inquiries, and guide you through processes. Is there something specific you'd like help with?`;
      }
      
      // Return null if no match found
      return null;
    }

    // Send message to the chatbot
    async function sendMessage() {
      const userInput = document.getElementById('user-input');
      const message = userInput.value.trim();
      const loadingIndicator = document.getElementById('loading-indicator');
      const sendButton = document.getElementById('send-button');
      
      if (!message) return;
      
      addMessage(message, 'user');
      userInput.value = '';
      
      // Disable input and button during processing
      userInput.disabled = true;
      sendButton.disabled = true;
      
      // Check for common questions first
      const defaultResponse = handleCommonQuestions(message);
      if (defaultResponse) {
        // Use a small delay to simulate processing
        setTimeout(() => {
          addMessage(defaultResponse, 'bot');
          // Re-enable input and button
          userInput.disabled = false;
          sendButton.disabled = false;
          userInput.focus();
        }, 500);
        return;
      }
      
      // If chatbot isn't trained and this isn't a common question, inform the user
      if (!isChatbotTrained) {
        setTimeout(() => {
          addMessage("I need to be trained with specific knowledge to answer that question. Please go to the Chatbot Builder and add some FAQs or knowledge base content.", 'bot');
          showAlert('Your chatbot needs training. Add FAQs in the Chatbot Builder.', 'warning');
          
          // Re-enable input and button
          userInput.disabled = false;
          sendButton.disabled = false;
          userInput.focus();
        }, 500);
        return;
      }
      
      // Show loading indicator
      loadingIndicator.style.display = 'block';
      
      try {
        // Format history for the API
        const historyForAPI = conversationHistory.map(msg => ({
          role: msg.sender === 'user' ? 'user' : 'assistant',
          content: msg.message
        }));
        
        // Build URL with session ID if available
        let url = '/api/chatbot/inference';
        if (chatSessionId) {
          url += `?session_id=${chatSessionId}`;
        }
        
        const response = await fetch(url, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            company_id: companyId,
            query: message,
            history: historyForAPI.slice(0, -1) // Exclude the message we just sent
          })
        });
        
        const data = await response.json();
        
        // Hide loading indicator
        loadingIndicator.style.display = 'none';
        
        // Check if the chatbot is not trained yet
        if (data.status === 'error' && data.response && data.response.includes("I'm not trained yet")) {
          // Update the trained flag
          isChatbotTrained = false;
          
          // Show a more user-friendly message
          const friendlyResponse = "I'm ready to help, but I need some knowledge first! Please go to the Chatbot Builder page and add some FAQs or knowledge base content, then try again.";
          addMessage(friendlyResponse, 'bot');
          
          // Show an alert with instructions
          showAlert("Your chatbot needs training. Please add content in the Chatbot Builder and click Save to train your chatbot.", 'warning');
          
          // Add a training instruction
          setTimeout(() => {
            addMessage("To train me: 1) Go to Chatbot Builder, 2) Add FAQs or upload knowledge base content, 3) Click Save, 4) Return here to test", 'bot');
          }, 1000);
        }
        else if (data.status === 'success' || data.response) {
          // Store session ID for future requests
          if (data.session_id) {
            chatSessionId = data.session_id;
            localStorage.setItem('chat_session_id', data.session_id);
          }
          
          // Update the trained flag if we got a successful response
          isChatbotTrained = true;
          
          // Display the bot's response with message ID if available
          let messageId = null;
          if (data.message_id) {
            messageId = data.message_id;
          }
          
          addMessage(data.response, 'bot', messageId);
        } else {
          throw new Error(data.message || 'Unknown error occurred');
        }
      } catch (error) {
        console.error('Error sending message:', error);
        loadingIndicator.style.display = 'none';
        
        showAlert('Error: ' + error.message, 'danger');
        addMessage("Sorry, there was an error processing your request. Please try again.", 'bot');
      } finally {
        // Re-enable input and button
        userInput.disabled = false;
        sendButton.disabled = false;
        userInput.focus();
      }
    }

    // Show alert messages
    function showAlert(message, type) {
      const alertContainer = document.querySelector('.alert-container');
      
      // Create alert element
      const alert = document.createElement('div');
      alert.className = `alert alert-${type}`;
      alert.innerHTML = `<span>${message}</span><button type="button" class="close" aria-label="Close">&times;</button>`;
      
      // Add close button functionality
      const closeButton = alert.querySelector('.close');
      closeButton.addEventListener('click', function() {
        alert.remove();
      });
      
      // Add to container
      alertContainer.appendChild(alert);
      
      // Auto-remove after 5 seconds for non-error alerts
      if (type !== 'danger') {
        setTimeout(() => {
          if (alert.parentNode) {
            alert.remove();
          }
        }, 5000);
      }
    }

    // Initialize on DOM content loaded
    document.addEventListener('DOMContentLoaded', initTestInterface);
  </script>
</body>
</html>
